# Salin menjadi .env lalu isi. Jangan commit file .env.

# 1 untuk lokal, 0 untuk server
DEBUG=1
# Wajib bila DEBUG=0. Buat dengan:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# Kosongkan DB_HOST untuk memakai SQLite lokal
DB_HOST=
DB_PORT=5432
DB_NAME=smarttps
DB_USER=postgres
DB_PASS=
